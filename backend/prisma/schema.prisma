datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String    @id // Matches Firebase Auth UID
  email    String    @unique
  name      String
  phone     String?
  photoData Bytes?
  hasPhoto  Boolean   @default(false)
  reports   Report[]
  comments Comment[]
}

model Report {
  id          String   @id @default(uuid())
  title       String
  description String
  category    Category
  type        ReportType @default(LOST)
  status      Status   @default(ACTIVE)
  latitude    Float
  longitude   Float
  imageData   Bytes?   // Raw binary image data stored in PostgreSQL
  hasImage    Boolean  @default(false) // Optimize queries without loading raw image
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  comments    Comment[]

  @@index([authorId])
  @@index([status])
  @@index([category])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  createdAt DateTime @default(now())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  @@index([reportId])
  @@index([authorId])
}

enum Category {
  PETS
  ELECTRONICS
  KEYS
  WALLET
  BAG
  OTHER
}

enum ReportType {
  LOST
  FOUND
}

enum Status {
  ACTIVE
  RESOLVED
}
